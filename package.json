{
  "name": "@chemistry/crystallography-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Crystal Structure Search Application",
  "license": "MIT",
  "author": {
    "name": "Volodymyr Vreshch",
    "url": "https://vreshch.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chemistry/crystallography.io.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/libraries/*",
    "packages/containers/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint 'packages/**/*.{ts,tsx}'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npx vite packages/containers/c14-web",
    "clean": "rimraf packages/**/dist coverage",
    "verify": "npm run build && npm run lint && npm run test",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:headed": "playwright test --config playwright.config.ts --headed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.4",
    "rimraf": "^5.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
